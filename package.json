{
  "name": "claude-local-bridge",
  "version": "1.0.34",
  "private": true,
  "description": "A local-first Windows desktop client for persistent Claude Code sessions over SSH and tmux.",
  "main": "./out/main/index.js",
  "author": "Local development",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:remote": "python -m unittest discover -s tests/remote -p \"test_*.py\"",
    "test:all": "npm run test && npm run test:remote",
    "test:e2e": "playwright test tests/e2e/personal-config.spec.ts tests/e2e/packaged-size.spec.ts tests/e2e/portable.spec.ts",
    "test:e2e:scenarios": "playwright test tests/e2e/content-rendering.spec.ts tests/e2e/activity-layout.spec.ts tests/e2e/panel-docking.spec.ts tests/e2e/remote-files.spec.ts tests/e2e/turn-response.spec.ts",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "electron-store": "11.0.2",
    "node-pty": "1.1.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@eslint/js": "10.0.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/mona-sans": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@playwright/test": "1.63.0",
    "@radix-ui/react-dialog": "1.1.15",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.2.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "29.1.1",
    "katex": "0.19.0",
    "lowlight": "3.3.0",
    "lucide-react": "1.41.0",
    "mermaid": "12.1.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6",
    "vitest": "5.0.0",
    "zustand": "5.0.15"
  }
}
